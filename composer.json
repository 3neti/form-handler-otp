{
    "name": "3neti/form-handler-otp",
    "description": "OTP verification handler for form flow system",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "3neti",
            "email": "info@3neti.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "3neti/form-flow": "^1.8",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.3 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\FormHandlerOtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\FormHandlerOtp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBHurtado\\FormHandlerOtp\\OtpHandlerServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "post-install-cmd": [
            "@php -r \"file_exists('../../artisan') && system('cd ../.. && php artisan otp-handler:install --no-interaction 2>/dev/null || true');\""
        ],
        "post-update-cmd": [
            "@php -r \"file_exists('../../artisan') && system('cd ../.. && php artisan otp-handler:install --no-interaction 2>/dev/null || true');\""
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
